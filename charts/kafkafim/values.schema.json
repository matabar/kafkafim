{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kafkafim chart values",
  "description": "Shape of the values. Cross-field rules (pipeline/group assignment, secret mount paths, replica floor, image tag) are enforced by `fail` in templates/_helpers.tpl.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" },
        "claims": { "type": "array" }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minAvailable": { "type": ["integer", "string", "null"] },
        "maxUnavailable": { "type": ["integer", "string", "null"] }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "periodSeconds", "failureThreshold", "timeoutSeconds"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipelines"],
      "properties": {
        "pipelines": {
          "description": "Names of pipelines under config.kafkafim.pipelines that this group runs.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "replicas": { "type": "integer", "minimum": 1 },
        "allowSingleReplica": { "type": "boolean" },
        "resources": { "$ref": "#/definitions/resources" },
        "autoscaling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        "pdb": { "$ref": "#/definitions/pdb" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" },
        "podAnnotations": { "$ref": "#/definitions/stringMap" }
      }
    }
  },
  "properties": {
    "global": { "type": "object" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "repository", "tag", "pullPolicy"],
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": { "name": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kafkafim"],
      "properties": {
        "kafkafim": {
          "description": "Only kafka, elasticsearch and pipelines are rendered into the per-group application-kafkafim.yaml; any other key (e.g. allow-inline-secrets, local development only) is rejected rather than silently dropped.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kafka": { "type": "object" },
            "elasticsearch": { "type": "object" },
            "pipelines": {
              "type": "object",
              "additionalProperties": { "type": "object" }
            }
          }
        }
      }
    },
    "secrets": {
      "description": "Existing Secrets mounted read-only for configtree; mountPath rules are checked in templates.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "mountPath"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "mountPath": { "type": "string", "minLength": 1 }
        }
      }
    },
    "groups": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$" },
      "additionalProperties": { "$ref": "#/definitions/group" }
    },
    "resources": { "$ref": "#/definitions/resources" },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "otel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint"],
      "properties": {
        "endpoint": { "type": "string", "minLength": 1 },
        "headers": { "$ref": "#/definitions/stringMap" }
      }
    },
    "jvm": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "options": { "type": "string" } }
    },
    "extraEnv": {
      "type": "array",
      "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 } } }
    },
    "extraEnvFrom": { "type": "array", "items": { "type": "object" } },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "annotations": { "$ref": "#/definitions/stringMap" } }
    },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "liveness", "readiness"],
      "properties": {
        "startup": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" }
      }
    },
    "pdb": { "$ref": "#/definitions/pdb" },
    "topologySpread": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "topologyKey": { "type": "string", "minLength": 1 },
        "maxSkew": { "type": "integer", "minimum": 1 },
        "whenUnsatisfiable": { "enum": ["ScheduleAnyway", "DoNotSchedule"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowFrom": { "type": "array", "items": { "type": "object" } }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "labels": { "$ref": "#/definitions/stringMap" }
      }
    },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "podAnnotations": { "$ref": "#/definitions/stringMap" }
  }
}
