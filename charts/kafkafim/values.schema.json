{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kafkafim chart values",
  "description": "Shape of the values. Cross-field rules (pipeline/group assignment, secret mount paths, replica floor, image tag without @) are enforced by `fail` in templates/_helpers.tpl.",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "pipeline": {
      "description": "One kafkafim pipeline; the application validates it in full at startup and on reload (DESIGN §5.7). The chart checks only the shape of its routes.",
      "type": "object",
      "properties": {
        "routes": {
          "type": "array",
          "items": { "$ref": "#/definitions/route" }
        }
      }
    },
    "route": {
      "description": "A routing rule (DESIGN §5.3). drop: true discards the documents it selects (ADR-0037) and takes the place of cluster, identity, index and pipeline.",
      "type": "object",
      "properties": {
        "drop": { "type": "boolean" },
        "default": { "type": "boolean" }
      },
      "if": {
        "properties": { "drop": { "const": true } },
        "required": ["drop"]
      },
      "then": {
        "properties": {
          "cluster": { "not": {}, "description": "drop: true takes no cluster" },
          "identity": { "not": {}, "description": "drop: true takes no identity" },
          "index": { "not": {}, "description": "drop: true takes no index" },
          "pipeline": { "not": {}, "description": "drop: true takes no ingest pipeline" }
        }
      },
      "else": {
        "required": ["cluster", "index"]
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "httpHeaderName": {
      "description": "Letters, digits and '-': a valid HTTP header name that is also a safe file name and configtree property key.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests": { "type": "object" },
        "limits": { "type": "object" },
        "claims": { "type": "array" }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minAvailable": { "type": ["integer", "string", "null"] },
        "maxUnavailable": { "type": ["integer", "string", "null"] }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "periodSeconds", "failureThreshold", "timeoutSeconds"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipelines"],
      "properties": {
        "pipelines": {
          "description": "Names of pipelines under config.kafkafim.pipelines that this group runs.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "replicas": { "type": "integer", "minimum": 1 },
        "allowSingleReplica": { "type": "boolean" },
        "resources": { "$ref": "#/definitions/resources" },
        "autoscaling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        "pdb": { "$ref": "#/definitions/pdb" },
        "nodeSelector": { "$ref": "#/definitions/stringMap" },
        "tolerations": { "type": "array", "items": { "type": "object" } },
        "affinity": { "type": "object" },
        "podAnnotations": { "$ref": "#/definitions/stringMap" }
      }
    }
  },
  "properties": {
    "global": { "type": "object" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "repository", "pullPolicy"],
      "properties": {
        "registry": { "type": "string" },
        "repository": { "type": "string", "minLength": 1 },
        "tag": {
          "description": "Image tag; empty or absent for the chart's appVersion. Neither tag nor digest is required: appVersion also names the image, which the schema cannot see, so the template checks that one of the three is set.",
          "type": "string"
        },
        "digest": {
          "description": "Image digest to pin, sha256:<64 lowercase hex>; empty for none. Not a full reference: the registry and repository come from image.registry and image.repository.",
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": { "name": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kafkafim"],
      "properties": {
        "kafkafim": {
          "description": "Only kafka, elasticsearch and pipelines are rendered into the per-group application-kafkafim.yaml; any other key (e.g. allow-inline-secrets, local development only) is rejected rather than silently dropped.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kafka": { "type": "object" },
            "elasticsearch": { "type": "object" },
            "pipelines": {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/pipeline" }
            }
          }
        }
      }
    },
    "secrets": {
      "description": "Existing Secrets mounted read-only for configtree; mountPath rules are checked in templates.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "mountPath"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "mountPath": { "type": "string", "minLength": 1 }
        }
      }
    },
    "groups": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$" },
      "additionalProperties": { "$ref": "#/definitions/group" }
    },
    "resources": { "$ref": "#/definitions/resources" },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "type": "array", "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "otel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint"],
      "properties": {
        "endpoint": { "type": "string", "minLength": 1 },
        "headers": {
          "description": "Non-secret OTLP export headers (metrics, traces and logs), header name -> value.",
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/httpHeaderName" },
          "additionalProperties": { "type": "string" }
        },
        "secretHeaders": {
          "description": "Secret OTLP export headers (metrics, traces and logs), header name -> key of an existing Secret.",
          "type": "object",
          "propertyNames": { "$ref": "#/definitions/httpHeaderName" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["secretName", "key"],
            "properties": {
              "secretName": { "type": "string", "minLength": 1 },
              "key": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "jvm": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "options": { "type": "string" } }
    },
    "extraEnv": {
      "type": "array",
      "items": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 } } }
    },
    "extraEnvFrom": { "type": "array", "items": { "type": "object" } },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "annotations": { "$ref": "#/definitions/stringMap" } }
    },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "liveness", "readiness"],
      "properties": {
        "startup": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" }
      }
    },
    "pdb": { "$ref": "#/definitions/pdb" },
    "topologySpread": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "topologyKey": { "type": "string", "minLength": 1 },
        "maxSkew": { "type": "integer", "minimum": 1 },
        "whenUnsatisfiable": { "enum": ["ScheduleAnyway", "DoNotSchedule"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowFrom": { "type": "array", "items": { "type": "object" } }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "labels": { "$ref": "#/definitions/stringMap" }
      }
    },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "podAnnotations": { "$ref": "#/definitions/stringMap" }
  }
}
