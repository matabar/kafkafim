# Google Java Style: 2-space indent, 100-column limit, LF, UTF-8.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = space
indent_size = 2
continuation_indent_size = 4
max_line_length = 100

[*.{xml,yaml,yml,json,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
