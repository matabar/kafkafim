  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false,
        "options": [],
        "skipUrlSync": false
      },
      {
        "name": "es_cluster",
        "label": "ES cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(kafkafim_breaker_state, es_cluster)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(kafkafim_breaker_state, es_cluster)",
        "current": {},
        "hide": 0,
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "options": [],
        "skipUrlSync": false
      },
      {
        "name": "pipeline",
        "label": "Pipeline",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(kafkafim_bulk_docs_count, pipeline)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 1
        },
        "definition": "label_values(kafkafim_bulk_docs_count, pipeline)",
        "current": {},
        "hide": 0,
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "options": [],
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Circuit breaker",
      "collapsed": false,
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Breaker state",
      "description": "Per Elasticsearch cluster: 0 closed, 1 half-open, 2 open (the worst one while a reload leaves two generations alive). Open pauses every pipeline sending to it (RUNBOOK \u00a75.1).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "closed",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "half-open",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "open",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (es_cluster) (kafkafim_breaker_state{es_cluster=~\"$es_cluster\"})",
          "legendFormat": "{{es_cluster}}",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Breaker state over time",
      "description": "0 closed, 1 half-open, 2 open.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (es_cluster) (kafkafim_breaker_state{es_cluster=~\"$es_cluster\"})",
          "legendFormat": "{{es_cluster}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "row",
      "title": "Bulk requests",
      "collapsed": false,
      "id": 4,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Bulk requests by status",
      "description": "Every attempt, by HTTP status; io_error is a request without a response.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (es_cluster, status) (rate(kafkafim_bulk_requests_total{pipeline=~\"$pipeline\",es_cluster=~\"$es_cluster\"}[$__rate_interval]))",
          "legendFormat": "{{es_cluster}} {{status}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Rejected (429) ratio",
      "description": "Bulk requests answered 429 over all bulk requests. Above 1% for 5m fires KafkafimBulkRejectRatioHigh. Reads 0 while no request was rejected.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "(sum by (es_cluster) (rate(kafkafim_bulk_requests_total{pipeline=~\"$pipeline\",es_cluster=~\"$es_cluster\",status=\"429\"}[$__rate_interval])) or 0 * sum by (es_cluster) (rate(kafkafim_bulk_requests_total{pipeline=~\"$pipeline\",es_cluster=~\"$es_cluster\"}[$__rate_interval]))) / sum by (es_cluster) (rate(kafkafim_bulk_requests_total{pipeline=~\"$pipeline\",es_cluster=~\"$es_cluster\"}[$__rate_interval]))",
          "legendFormat": "{{es_cluster}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Bulk latency",
      "description": "From sending to the parsed response, per answered request.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (es_cluster, le) (rate(kafkafim_bulk_latency_seconds_bucket{pipeline=~\"$pipeline\",es_cluster=~\"$es_cluster\"}[$__rate_interval])))",
          "legendFormat": "p99 {{es_cluster}}",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (es_cluster, le) (rate(kafkafim_bulk_latency_seconds_bucket{pipeline=~\"$pipeline\",es_cluster=~\"$es_cluster\"}[$__rate_interval])))",
          "legendFormat": "p50 {{es_cluster}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Docs per request",
      "description": "Mean actions per answered bulk request.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (es_cluster) (rate(kafkafim_bulk_docs_sum{pipeline=~\"$pipeline\",es_cluster=~\"$es_cluster\"}[$__rate_interval])) / sum by (es_cluster) (rate(kafkafim_bulk_docs_count{pipeline=~\"$pipeline\",es_cluster=~\"$es_cluster\"}[$__rate_interval]))",
          "legendFormat": "{{es_cluster}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Bytes per request",
      "description": "Mean uncompressed body size per answered bulk request.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (es_cluster) (rate(kafkafim_bulk_bytes_sum{pipeline=~\"$pipeline\",es_cluster=~\"$es_cluster\"}[$__rate_interval])) / sum by (es_cluster) (rate(kafkafim_bulk_bytes_count{pipeline=~\"$pipeline\",es_cluster=~\"$es_cluster\"}[$__rate_interval]))",
          "legendFormat": "{{es_cluster}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Batch flushes by reason",
      "description": "Sealed batches by the limit that sealed them (explicit: revoke, stop). Mostly age means traffic is below the batch size.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (es_cluster, reason) (rate(kafkafim_batch_flush_total{pipeline=~\"$pipeline\",es_cluster=~\"$es_cluster\"}[$__rate_interval]))",
          "legendFormat": "{{es_cluster}} {{reason}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
