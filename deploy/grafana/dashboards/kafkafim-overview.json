    {
      "type": "timeseries",
      "id": 10,
      "title": "End-to-end latency",
      "description": "Elasticsearch ack time minus the Kafka record timestamp (DLQ'd documents are not counted). Buckets end at 1h; above it the quantile reads as 1h. Consumer lag is not a kafkafim metric: see the Kafka team's consumer-lag monitoring for the pipeline's consumer group (ADR-0034).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (pipeline, le) (rate(kafkafim_e2e_latency_seconds_bucket{pipeline=~\"$pipeline\"}[$__rate_interval])))",
          "legendFormat": "p99 {{pipeline}}",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.5, sum by (pipeline, le) (rate(kafkafim_e2e_latency_seconds_bucket{pipeline=~\"$pipeline\"}[$__rate_interval])))",
          "legendFormat": "p50 {{pipeline}}",
          "range": true,
          "instant": false
        }
      ]
    },
