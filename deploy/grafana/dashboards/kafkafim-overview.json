      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (pipeline, error_type) (rate(kafkafim_dlq_records_total{pipeline=~\"$pipeline\"}[$__rate_interval]))",
          "legendFormat": "{{pipeline}} {{error_type}}",
          "range": true,
          "instant": false
        }
