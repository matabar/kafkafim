    {
      "type": "stat",
      "id": 2,
      "title": "running (pod \u00d7 pipeline)",
      "description": "Count of (pod, pipeline) pairs whose kafkafim_pipeline_state{state=\"running\"} is 1.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(kafkafim_pipeline_state{pipeline=~\"$pipeline\",state=\"running\"}) or vector(0)",
          "legendFormat": "running",
          "range": false,
          "instant": true
        }
      ]
