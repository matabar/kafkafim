    {
      "type": "timeseries",
      "id": 17,
      "title": "DLQ records by error type",
      "description": "DLQ records the broker acknowledged. Any sustained rate fires KafkafimDlqRecords (RUNBOOK \u00a75.6).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
