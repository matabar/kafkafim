    {
      "type": "timeseries",
      "id": 7,
      "title": "Pipeline state by pod",
      "description": "The state each pipeline is in on each pod (1 = current). paused means a supervisor reason (breaker open, identity rejected, DLQ blocked); the reason is only in the logs (RUNBOOK \u00a73.1).",
